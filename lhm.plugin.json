{
    "identifier":  "shakil197-solmarrow-mcp",
    "name":  "SolMarrow",
    "version":  "1.1.0",
    "description":  "Free AI agent social media posting: draft, schedule and publish to 19 networks (X, LinkedIn, Facebook, Instagram, Threads, Bluesky, TikTok, YouTube, Pinterest, Telegram, Discord and more), upload media and read analytics. Remote MCP with OAuth sign-in; free plan with unlimited posts.",
    "author":  "SolMarrow",
    "authorUrl":  "https://solmarrow.com",
    "homepage":  "https://solmarrow.com/ai-agents",
    "cloudEndpoint":  "https://mcp.solmarrow.com/mcp",
    "icon":  "https://solmarrow.com/brand/solmarrow-icon-512.png",
    "tags":  [
                 "social media",
                 "scheduling",
                 "marketing",
                 "linkedin",
                 "x",
                 "instagram",
                 "content"
             ],
    "tools":  [
                  {
                      "name":  "list_workspaces",
                      "description":  "Workspaces this agent may use, with their time zones.",
                      "inputSchema":  {
                                          "type":  "object",
                                          "properties":  {

                                                         }
                                      }
                  },
                  {
                      "name":  "list_accounts",
                      "description":  "Connected social accounts in a workspace, with each network\u0027s posting rules (character limit, media limits).",
                      "inputSchema":  {
                                          "type":  "object",
                                          "properties":  {
                                                             "workspace_id":  {
                                                                                  "type":  "string",
                                                                                  "format":  "uuid",
                                                                                  "pattern":  "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                                                                                  "description":  "Workspace id from list_workspaces"
                                                                              }
                                                         },
                                          "required":  [
                                                           "workspace_id"
                                                       ]
                                      }
                  },
                  {
                      "name":  "create_post",
                      "description":  "Saves a draft, or schedules a post to one or more accounts at least 5 minutes ahead (it shows in the person\u0027s calendar before it goes out). Each account\u0027s text is checked against that network\u0027s rules first. TikTok posts can only be saved as drafts here (the person finishes them in SolMarrow). Posts to X use X credits unless the workspace has its own X key.",
                      "inputSchema":  {
                                          "type":  "object",
                                          "properties":  {
                                                             "workspace_id":  {
                                                                                  "type":  "string",
                                                                                  "format":  "uuid",
                                                                                  "pattern":  "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                                                                              },
                                                             "text":  {
                                                                          "type":  "string",
                                                                          "maxLength":  10000,
                                                                          "description":  "Post text. Use per_account_text to change it for one account."
                                                                      },
                                                             "account_ids":  {
                                                                                 "default":  [

                                                                                             ],
                                                                                 "description":  "Accounts to post to (from list_accounts). Required unless saving a draft.",
                                                                                 "maxItems":  50,
                                                                                 "type":  "array",
                                                                                 "items":  {
                                                                                               "type":  "string",
                                                                                               "format":  "uuid",
                                                                                               "pattern":  "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                                                                                           }
                                                                             },
                                                             "schedule_at":  {
                                                                                 "description":  "When to publish, ISO 8601 with offset, at least 5 minutes from now. Leave out to save a draft.",
                                                                                 "type":  "string",
                                                                                 "format":  "date-time",
                                                                                 "pattern":  "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                                                                             },
                                                             "publish_now":  {
                                                                                 "description":  "REST API only: publish right away (the person pressed a publish button in your app). AI agents schedule instead.",
                                                                                 "type":  "boolean"
                                                                             },
                                                             "draft":  {
                                                                           "description":  "Save as a draft (not scheduled). Default: draft when schedule_at and publish_now are missing.",
                                                                           "type":  "boolean"
                                                                       },
                                                             "media_ids":  {
                                                                               "default":  [

                                                                                           ],
                                                                               "description":  "Media from the library, in order (upload first).",
                                                                               "maxItems":  35,
                                                                               "type":  "array",
                                                                               "items":  {
                                                                                             "type":  "string",
                                                                                             "format":  "uuid",
                                                                                             "pattern":  "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                                                                                         }
                                                                           },
                                                             "per_account_text":  {
                                                                                      "description":  "Different text for some accounts: { account_id: text }.",
                                                                                      "type":  "object",
                                                                                      "propertyNames":  {
                                                                                                            "type":  "string"
                                                                                                        },
                                                                                      "additionalProperties":  {
                                                                                                                   "type":  "string",
                                                                                                                   "maxLength":  10000
                                                                                                               }
                                                                                  },
                                                             "per_account_options":  {
                                                                                         "description":  "Settings some networks use: YouTube {title, privacy: public|unlisted|private, madeForKids}; Pinterest {boardId, title, link}; Dribbble {title, tags}; Tumblr {tags}; WordPress/DEV/Ghost {title, tags, status: publish|draft}.",
                                                                                         "type":  "object",
                                                                                         "propertyNames":  {
                                                                                                               "type":  "string"
                                                                                                           },
                                                                                         "additionalProperties":  {
                                                                                                                      "type":  "object",
                                                                                                                      "propertyNames":  {
                                                                                                                                            "type":  "string"
                                                                                                                                        },
                                                                                                                      "additionalProperties":  {
                                                                                                                                                   "anyOf":  [
                                                                                                                                                                 {
                                                                                                                                                                     "type":  "string",
                                                                                                                                                                     "maxLength":  2048
                                                                                                                                                                 },
                                                                                                                                                                 {
                                                                                                                                                                     "type":  "boolean"
                                                                                                                                                                 }
                                                                                                                                                             ]
                                                                                                                                               }
                                                                                                                  }
                                                                                     },
                                                             "idempotency_key":  {
                                                                                     "description":  "Any unique string for this post (REST: the Idempotency-Key header). Sending the same key again returns the first post instead of creating a second one, so a retry after a timeout is safe.",
                                                                                     "type":  "string",
                                                                                     "minLength":  1,
                                                                                     "maxLength":  200
                                                                                 }
                                                         },
                                          "required":  [
                                                           "workspace_id",
                                                           "text"
                                                       ]
                                      }
                  },
                  {
                      "name":  "list_posts",
                      "description":  "Posts in a workspace, newest first, with each account\u0027s publishing status and link.",
                      "inputSchema":  {
                                          "type":  "object",
                                          "properties":  {
                                                             "workspace_id":  {
                                                                                  "type":  "string",
                                                                                  "format":  "uuid",
                                                                                  "pattern":  "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                                                                              },
                                                             "status":  {
                                                                            "type":  "string",
                                                                            "enum":  [
                                                                                         "draft",
                                                                                         "scheduled",
                                                                                         "publishing",
                                                                                         "published",
                                                                                         "partially_published",
                                                                                         "failed"
                                                                                     ]
                                                                        },
                                                             "from":  {
                                                                          "description":  "Only posts scheduled or created from this time",
                                                                          "type":  "string",
                                                                          "format":  "date-time",
                                                                          "pattern":  "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                                                                      },
                                                             "to":  {
                                                                        "description":  "Only posts scheduled or created before this time",
                                                                        "type":  "string",
                                                                        "format":  "date-time",
                                                                        "pattern":  "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                                                                    },
                                                             "limit":  {
                                                                           "default":  20,
                                                                           "type":  "integer",
                                                                           "minimum":  1,
                                                                           "maximum":  50
                                                                       }
                                                         },
                                          "required":  [
                                                           "workspace_id"
                                                       ]
                                      }
                  },
                  {
                      "name":  "get_post",
                      "description":  "One post with its text, media, accounts, publishing status, errors and latest results.",
                      "inputSchema":  {
                                          "type":  "object",
                                          "properties":  {
                                                             "post_id":  {
                                                                             "type":  "string",
                                                                             "format":  "uuid",
                                                                             "pattern":  "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                                                                         }
                                                         },
                                          "required":  [
                                                           "post_id"
                                                       ]
                                      }
                  },
                  {
                      "name":  "delete_post",
                      "description":  "Deletes a draft, scheduled or failed post. Published posts stay on the networks; posts being published right now can\u0027t be deleted.",
                      "inputSchema":  {
                                          "type":  "object",
                                          "properties":  {
                                                             "post_id":  {
                                                                             "type":  "string",
                                                                             "format":  "uuid",
                                                                             "pattern":  "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                                                                         }
                                                         },
                                          "required":  [
                                                           "post_id"
                                                       ]
                                      }
                  },
                  {
                      "name":  "list_media",
                      "description":  "Recent files in a workspace\u0027s media library.",
                      "inputSchema":  {
                                          "type":  "object",
                                          "properties":  {
                                                             "workspace_id":  {
                                                                                  "type":  "string",
                                                                                  "format":  "uuid",
                                                                                  "pattern":  "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                                                                              },
                                                             "limit":  {
                                                                           "default":  30,
                                                                           "type":  "integer",
                                                                           "minimum":  1,
                                                                           "maximum":  100
                                                                       }
                                                         },
                                          "required":  [
                                                           "workspace_id"
                                                       ]
                                      }
                  },
                  {
                      "name":  "upload_media_from_url",
                      "description":  "Copies an image or video from a public link into the workspace\u0027s media library and returns its media id.",
                      "inputSchema":  {
                                          "type":  "object",
                                          "properties":  {
                                                             "workspace_id":  {
                                                                                  "type":  "string",
                                                                                  "format":  "uuid",
                                                                                  "pattern":  "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                                                                              },
                                                             "url":  {
                                                                         "type":  "string",
                                                                         "maxLength":  2000,
                                                                         "format":  "uri",
                                                                         "description":  "Public https link to a JPG, PNG, WebP, GIF, MP4, MOV or WebM file (any size that fits the workspace storage)"
                                                                     },
                                                             "file_name":  {
                                                                               "type":  "string",
                                                                               "minLength":  1,
                                                                               "maxLength":  255
                                                                           }
                                                         },
                                          "required":  [
                                                           "workspace_id",
                                                           "url"
                                                       ]
                                      }
                  },
                  {
                      "name":  "create_media_upload",
                      "description":  "For agents that can make HTTP requests: returns a link to PUT the file to (1 hour, files up to 90 MB). Then call finish_media_upload.",
                      "inputSchema":  {
                                          "type":  "object",
                                          "properties":  {
                                                             "workspace_id":  {
                                                                                  "type":  "string",
                                                                                  "format":  "uuid",
                                                                                  "pattern":  "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                                                                              },
                                                             "file_name":  {
                                                                               "type":  "string",
                                                                               "minLength":  1,
                                                                               "maxLength":  255
                                                                           },
                                                             "mime_type":  {
                                                                               "type":  "string",
                                                                               "pattern":  "^(image\\/(jpeg|png|webp|gif)|video\\/(mp4|quicktime|webm))$"
                                                                           },
                                                             "size":  {
                                                                          "type":  "integer",
                                                                          "exclusiveMinimum":  0,
                                                                          "maximum":  9007199254740991,
                                                                          "description":  "File size in bytes (up to 90 MB here; larger files: use upload_media_from_url)"
                                                                      }
                                                         },
                                          "required":  [
                                                           "workspace_id",
                                                           "file_name",
                                                           "mime_type",
                                                           "size"
                                                       ]
                                      }
                  },
                  {
                      "name":  "finish_media_upload",
                      "description":  "Adds a file uploaded with create_media_upload to the media library.",
                      "inputSchema":  {
                                          "type":  "object",
                                          "properties":  {
                                                             "workspace_id":  {
                                                                                  "type":  "string",
                                                                                  "format":  "uuid",
                                                                                  "pattern":  "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                                                                              },
                                                             "upload_id":  {
                                                                               "type":  "string",
                                                                               "maxLength":  200
                                                                           },
                                                             "file_name":  {
                                                                               "type":  "string",
                                                                               "minLength":  1,
                                                                               "maxLength":  255
                                                                           },
                                                             "mime_type":  {
                                                                               "type":  "string",
                                                                               "pattern":  "^(image\\/(jpeg|png|webp|gif)|video\\/(mp4|quicktime|webm))$"
                                                                           }
                                                         },
                                          "required":  [
                                                           "workspace_id",
                                                           "upload_id",
                                                           "file_name",
                                                           "mime_type"
                                                       ]
                                      }
                  },
                  {
                      "name":  "get_analytics",
                      "description":  "Latest likes, comments, shares and views for published posts (from the networks that share them).",
                      "inputSchema":  {
                                          "type":  "object",
                                          "properties":  {
                                                             "workspace_id":  {
                                                                                  "type":  "string",
                                                                                  "format":  "uuid",
                                                                                  "pattern":  "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                                                                              },
                                                             "from":  {
                                                                          "description":  "Published from (default: 30 days ago)",
                                                                          "type":  "string",
                                                                          "format":  "date-time",
                                                                          "pattern":  "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                                                                      },
                                                             "to":  {
                                                                        "type":  "string",
                                                                        "format":  "date-time",
                                                                        "pattern":  "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                                                                    },
                                                             "post_id":  {
                                                                             "description":  "Only this post",
                                                                             "type":  "string",
                                                                             "format":  "uuid",
                                                                             "pattern":  "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                                                                         }
                                                         },
                                          "required":  [
                                                           "workspace_id"
                                                       ]
                                      }
                  }
              ],
    "prompts":  [
                    {
                        "arguments":  [
                                          {
                                              "description":  "What the post is about, or the finished text",
                                              "name":  "topic",
                                              "required":  true
                                          },
                                          {
                                              "description":  "When to publish, e.g. \u0027tomorrow 9:00\u0027. Leave empty to save a draft.",
                                              "name":  "when",
                                              "required":  false
                                          },
                                          {
                                              "description":  "Which networks. Leave empty for all connected accounts.",
                                              "name":  "networks",
                                              "required":  false
                                          }
                                      ],
                        "description":  "Write and schedule one post to the person\u0027s connected social accounts.",
                        "name":  "schedule_post"
                    },
                    {
                        "arguments":  [
                                          {
                                              "description":  "The theme or campaign for the week",
                                              "name":  "theme",
                                              "required":  true
                                          },
                                          {
                                              "description":  "How many posts a day (default 1)",
                                              "name":  "posts_per_day",
                                              "required":  false
                                          }
                                      ],
                        "description":  "Draft a week of posts on one theme and save them as drafts in the SolMarrow calendar.",
                        "name":  "plan_week"
                    },
                    {
                        "arguments":  [
                                          {
                                              "description":  "How many days back to look (default 30)",
                                              "name":  "days",
                                              "required":  false
                                          }
                                      ],
                        "description":  "Summarize how recent posts performed and suggest what to post next.",
                        "name":  "analytics_report"
                    }
                ],
    "resources":  [
                      {
                          "mimeType":  "text/markdown",
                          "description":  "How SolMarrow posting works: drafts, scheduling, time zones and media.",
                          "name":  "guide",
                          "uri":  "solmarrow://guide"
                      },
                      {
                          "mimeType":  "application/json",
                          "description":  "The person\u0027s SolMarrow workspaces with their time zones.",
                          "name":  "workspaces",
                          "uri":  "solmarrow://workspaces"
                      }
                  ]
}